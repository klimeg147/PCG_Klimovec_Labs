<Window x:Class="LAB3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа 3 - Обработка изображений" Height="700" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Text="Радиус фильтра:" VerticalAlignment="Center" Margin="10,0,10,0"/>
            <TextBox x:Name="TxtRadius" Text="1" Width="50" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="0" Margin="10">
            <Button x:Name="BtnLoad" Content="Загрузить изображение" Height="30" Margin="0,0,0,15" Click="BtnLoad_Click"/>

            <TextBlock Text="Выберите метод обработки:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbMethods" Height="25" Margin="0,0,0,15" SelectedIndex="0">
                <ComboBoxItem Content="Нелинейный фильтр (Медианный)"/>
                <ComboBoxItem Content="Глобальная пороговая обработка (Оцу)"/>
                <ComboBoxItem Content="Глобальный метод по среднему"/>
                <ComboBoxItem Content="Адаптивная пороговая обработка"/>
            </ComboBox>

            <TextBlock Text="Обработка краев (Edge Padding):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbEdge" Height="25" Margin="0,0,0,15" SelectedIndex="0">
                <ComboBoxItem Content="Дублирование (Clamp)"/>
                <ComboBoxItem Content="Зеркальное отражение (Reflect)"/>
            </ComboBox>

            <Button x:Name="BtnProcess" Content="Применить обработку" Height="35" Background="#E0E0FF" FontWeight="Bold" Click="BtnProcess_Click" Margin="0,10,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="Исходное изображение" Grid.Column="0" Margin="5">
                    <Border BorderBrush="#CCCCCC" BorderThickness="1">
                        <Image x:Name="ImgOriginal" Stretch="Uniform"/>
                    </Border>
                </GroupBox>

                <GroupBox Header="Результат" Grid.Column="1" Margin="5">
                    <Border BorderBrush="#CCCCCC" BorderThickness="1">
                        <Image x:Name="ImgProcessed" Stretch="Uniform"/>
                    </Border>
                </GroupBox>
            </Grid>

            <StatusBar Grid.Row="1">
                <StatusBarItem>
                    <TextBlock x:Name="TxtStatus" Text="Готово к работе"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>